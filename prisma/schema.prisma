generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      String    @default("user")
  avatar    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  reviews     Review[]
  itineraries Itinerary[]
  bookings    Booking[]
  savedEvents SavedEvent[]
  wishlistItems WishlistItem[]
  wishlistShare WishlistShare?
  questions   Question[]
  answers     Answer[]
  ownedDestinations Destination[] @relation("OwnedDestinations")
  auditLogs   AuditLog[]
  notifications Notification[]
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String
  slug         String        @unique
  icon         String
  color        String
  parentId     Int?
  parent       Category?     @relation("CategoryChildren", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryChildren")
  destinations Destination[]
}

model Destination {
  id                Int      @id @default(autoincrement())
  name              String
  slug              String   @unique
  description       String   @db.Text
  categoryId        Int
  area              String
  address           String
  lat               Float
  lng               Float
  openHour          String
  closeHour         String
  ticketPrice       Int      @default(0)
  mainImage         String
  gallery           String   @db.Text
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  featured          Boolean  @default(false)
  hiddenGem         Boolean  @default(false)
  estimatedDuration Int      @default(60)
  facilities        String   @db.Text
  menus             String?  @db.Text
  status            String   @default("published")
  ownerId           Int?
  createdAt         DateTime @default(now())

  category       Category        @relation(fields: [categoryId], references: [id])
  owner          User?           @relation("OwnedDestinations", fields: [ownerId], references: [id])
  reviews        Review[]
  itineraryItems ItineraryItem[]
  bookings       Booking[]
  wishlistItems  WishlistItem[]
  questions      Question[]
}

model Review {
  id            Int         @id @default(autoincrement())
  userId        Int
  destinationId Int
  rating        Int
  comment       String      @db.Text
  createdAt     DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])
}

model Itinerary {
  id                Int             @id @default(autoincrement())
  userId            Int
  title             String
  duration          Int             @default(1)
  budget            Int             @default(0)
  area              String          @default("Semua Area")
  totalEstimatedCost Int            @default(0)
  notes             String?         @db.Text
  startDate         DateTime?
  isCanvas          Boolean         @default(false)
  createdAt         DateTime        @default(now())

  user  User            @relation(fields: [userId], references: [id])
  items ItineraryItem[]
}

model ItineraryItem {
  id                  Int         @id @default(autoincrement())
  itineraryId         Int
  destinationId       Int
  order               Int
  estimatedVisitTime  Int
  estimatedCost       Int         @default(0)
  transportNote       String?

  itinerary   Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])
}

model Booking {
  id            Int         @id @default(autoincrement())
  userId        Int
  destinationId Int
  visitDate     DateTime
  ticketCount   Int
  totalPrice    Int
  status        String      @default("pending")
  bookingCode   String      @unique
  createdAt     DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String   @db.Text
  location    String
  startDate   DateTime
  endDate     DateTime
  image       String
  category    String
  price       String   @default("Gratis")
  createdAt   DateTime @default(now())

  savedBy     SavedEvent[]
}

model SavedEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model WishlistItem {
  id            Int         @id @default(autoincrement())
  userId        Int
  destinationId Int
  note          String?     @db.Text
  createdAt     DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}

model WishlistShare {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  token     String   @unique
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id            Int         @id @default(autoincrement())
  userId        Int
  destinationId Int
  content       String      @db.Text
  createdAt     DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  answers     Answer[]
}

model Answer {
  id         Int      @id @default(autoincrement())
  userId     Int
  questionId Int
  content    String   @db.Text
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}